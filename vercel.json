{
  "rewrites": [
    {
      "source": "/api/recroom/:action",
      "destination": "/api/recroom?action=:action"
    },
    {
      "source": "/api/blitz/:action",
      "destination": "/api/blitz?action=:action"
    },
    {
      "source": "/api/command/:action",
      "destination": "/api/command?action=:action"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/ControlRoom",
      "destination": "/CAPCOM/index.html"
    },
    {
      "source": "/ControlRoom/:path*",
      "destination": "/CAPCOM/:path*"
    }
  ]
}
